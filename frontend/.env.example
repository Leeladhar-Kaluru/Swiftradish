# Copy is unnecessary: put real values in frontend/.env.local, which Git ignores.
# NEXT_PUBLIC_* values are embedded in browser JavaScript.
# The Vite app exposes NEXT_PUBLIC_* and VITE_* only. Never a secret key.
# Use the publishable key from the Supabase Connect panel. Never the secret key.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=replace_with_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
