# Put real values in backend/.env, which Git ignores.
# Do not paste this file into chat. FastAPI loads this path from the repo root.

APP_NAME=Swiftradish API
APP_ENV=development
LOG_LEVEL=info
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:3000

SUPABASE_URL=replace_with_supabase_project_url
SUPABASE_JWKS_URL=replace_with_supabase_jwks_url
SUPABASE_JWT_ISSUER=replace_with_supabase_jwt_issuer
SUPABASE_JWT_AUDIENCE=authenticated

# Session pooler, port 5432, from the Supabase Connect panel. URL-encode the password.
DATABASE_URL=replace_with_postgres_session_pooler_url
DATABASE_MIGRATION_URL=replace_with_postgres_session_pooler_url

# Used when media uploads are enabled. Leave the public base empty.
B2_REGION=eu-central-003
B2_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
B2_BUCKET_NAME=replace_with_your_bucket_name
B2_KEY_ID=replace_with_backblaze_application_key_id
B2_APPLICATION_KEY=replace_with_backblaze_application_key
B2_PUBLIC_BASE_URL=
